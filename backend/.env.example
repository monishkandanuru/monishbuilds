# Use a long, random value before deploying.
ADMIN_PASSWORD=replace-with-a-long-password
ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret

# SQLite is suitable for local development. Use a persistent mounted path in production.
DATABASE_PATH=./data/portfolio.db

# Your published portfolio address. Add other permitted origins as comma-separated values.
PORTFOLIO_ORIGIN=https://monishbuilds.vercel.app
